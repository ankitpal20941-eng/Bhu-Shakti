# Copy to backend/.env and adjust. Never commit the real file.
# All values have development defaults; the ones marked REQUIRED must be set in production.

BHUSHAKTI_ENV=demo                     # demo | production (production forces demo_mode off)
BHUSHAKTI_DEMO_MODE=true
# REQUIRED in production: HMAC key for session tokens (rotating it signs everyone out)
# BHUSHAKTI_SECRET_KEY=replace-with-a-48-byte-random-string
BHUSHAKTI_SESSION_TTL_MIN=720

# SQLite default; use PostgreSQL + psycopg in production
# BHUSHAKTI_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/bhushakti

# Comma-separated browser origins allowed to call the API with credentials
BHUSHAKTI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Weather / terrain ingestion
BHUSHAKTI_WEATHER_MODE=simulated       # auto | live | simulated
BHUSHAKTI_DEMO_RAINFALL=replay         # replay | live
BHUSHAKTI_OPEN_METEO_BASE=https://api.open-meteo.com/v1
BHUSHAKTI_INGESTION_ENABLED=true
BHUSHAKTI_INGESTION_ON_STARTUP=true
BHUSHAKTI_INGESTION_TIMEOUT_S=25

# Seeding and safety limits
BHUSHAKTI_SEED_DEMO=true
BHUSHAKTI_MAX_UPLOAD_BYTES=10485760
BHUSHAKTI_MAX_UPLOADS_PER_REPORT=3
BHUSHAKTI_ALERT_MIN_DURATION_MIN=30
BHUSHAKTI_ALERT_HYSTERESIS_POINTS=5
BHUSHAKTI_RATE_LOGIN=10
BHUSHAKTI_RATE_WRITE=60
BHUSHAKTI_MODEL_VERSION=suscept-v0.1+trigger-v0.1
BHUSHAKTI_LOG_LEVEL=INFO
